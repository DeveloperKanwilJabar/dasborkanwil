# === Identitas Aplikasi ===
APP_NAME="Dasbor Informasi"
FLASK_APP="run.py"
# Pilihan: production, development
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_PORT=5000 # Port default untuk development, ganti ke 80 untuk production
FLASK_SECRET_KEY=ganti-dengan-random-string-32-karakter
APP_TIMEZONE=Asia/Jakarta

# === CORS Configuration ===
# Daftar asal yang diizinkan untuk CORS, pisahkan dengan koma.
# Contoh: http://localhost:5000,https://dasborkanwil.kemenkum.go.id,https://api.jabarprov.go.id
CORS_ALLOWED_ORIGINS=http://localhost:5000

# === Database Configuration ===
# Pilihan driver: pgsql, mysql, oracle, sqlite
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dasborkanwil
DB_USER=postgres
DB_PASSWORD=

# === SQLAlchemy Tweaks ===
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ECHO=False
SQLALCHEMY_RECORD_QUERIES=True

# === Redis & Cache ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Session Configuration ===
SESSION_KEY_PREFIX=dasborkanwil_

# === Flask JWT ===
JWT_SECRET_KEY=ganti-dengan-random-string-64-karakter

# === Mail Configuration (Penting untuk Notifikasi) ===
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=email@gmail.com
# MAIL_PASSWORD=app-password-kamu
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false

# === Untuk trial bisa pakai mailtrap.io. ===
MAIL_SERVER='sandbox.smtp.mailtrap.io'
MAIL_PORT=2525 # Atau port lain yang disediakan Mailtrap
MAIL_USERNAME='' # Dari Mailtrap
MAIL_PASSWORD='' # Dari Mailtrap
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_SUPPRESS_SEND=False
MAIL_DEBUG=True

MAIL_DEFAULT_SENDER="Dasbor Informasi <no-reply@kemenkum.go.id>"

# Celery / analytics async refresh
CELERY_BROKER_URL=redis://global_redis:6379/0
CELERY_RESULT_BACKEND=redis://global_redis:6379/0
CELERY_TASK_IGNORE_RESULT=true
